{
  "manifest_version": 3,
  "name": "Focuence 智序 · 本机版",
  "version": "2.0.0",
  "minimum_chrome_version": "120",
  "description": "本机语义分组、任务恢复和注意力时间线。浏览记录与模型推理均留在本机。",
  "permissions": ["storage", "tabs", "tabGroups", "idle", "alarms", "offscreen"],
  "action": { "default_popup": "popup/index.html", "default_title": "Focuence 智序" },
  "options_page": "app/index.html",
  "background": { "service_worker": "background.js", "type": "module" },
  "commands": {
    "open_workspace": {
      "suggested_key": { "default": "Ctrl+Shift+F", "mac": "Command+Shift+F" },
      "description": "打开 Focuence 工作台"
    }
  },
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self'; worker-src 'self'"
  }
}
