{
  "manifest_version": 3,
  "name": "Focuence智序",
  "version": "1.0.0",
  "description": "智能标签页管理工具，通过AI增强的注意力算法和智能分组技术，帮助用户高效管理浏览器标签页",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "tabGroups",
    "notifications"
  ],
  "host_permissions": [
    "https://yunwu.zeabur.app/*"
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Focuence智序"
  },
  "options_page": "options/index.html",
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "smart_grouping": {
      "suggested_key": {
        "default": "Ctrl+Shift+G",
        "mac": "Command+Shift+G"
      },
      "description": "智能分组标签页"
    },
    "cleaning_suggestions": {
      "suggested_key": {
        "default": "Ctrl+Shift+C",
        "mac": "Command+Shift+C"
      },
      "description": "显示清理建议"
    },
    "toggle_popup": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "打开/关闭扩展面板"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}